# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL (ohne trailing slash)
NEXT_PUBLIC_APP_URL=http://www.headbang-handwerk.com

# Admin-Sessions
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Headbang-Admin (bevorzugt)
HEADBANG_ADMIN_USERNAME=headbang-admin
HEADBANG_ADMIN_PASSWORD_HASH=scrypt$32768$8$1$replace-salt$replace-hash

# Zollhaus-Admin
ZOLLHAUS_ADMIN_USERNAME=zollhaus-admin
ZOLLHAUS_ADMIN_PASSWORD_HASH=scrypt$32768$8$1$replace-salt$replace-hash

# Übergang nur für den bestehenden Headbang-Admin, danach entfernen
# CMS_ADMIN_USERNAME=legacy-admin
# CMS_ADMIN_PASSWORD=legacy-plain-text-password
# CMS_SESSION_SECRET=legacy-session-secret

# SMTP für interne Bestellmails aus dem Stripe-Webhook
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=change-me
SMTP_FROM=Headbang Handwerk <info@headbang-handwerk.de>
ZOLLHAUS_ORDER_EMAIL=orders@example.com

# Optional: Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
